# syntax=docker/dockerfile:1.7

# veritas-el
#
# Generated by gen_containers.py; keep in step with packaging/.

FROM opensuse/tumbleweed:latest AS builder

ARG VERSION=dev

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

WORKDIR /src

RUN --mount=type=cache,target=/var/cache/zypp \
    set -eu; \
    zypper --non-interactive refresh; \
    zypper --non-interactive install --no-recommends emacs; \
    zypper clean --all

COPY veritas.el ./

RUN set -eu; \
    emacs -Q --batch -f batch-byte-compile "veritas.el"

# ----------------------------------------------------------------------
# Runtime
# ----------------------------------------------------------------------

FROM opensuse/tumbleweed:latest AS runtime

ARG VERSION=dev

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

LABEL org.opencontainers.image.title="veritas-el" \
      org.opencontainers.image.description="Emacs integration for the Veritas test framework" \
      org.opencontainers.image.url="https://codeberg.org/jjba23/veritas.el" \
      org.opencontainers.image.licenses="LGPL-3.0-or-later" \
      org.opencontainers.image.version="${VERSION}"

RUN --mount=type=cache,target=/var/cache/zypp \
    set -eu; \
    zypper --non-interactive refresh; \
    zypper --non-interactive install --no-recommends emacs; \
    zypper clean --all

COPY --from=builder /src/veritas.el /usr/share/emacs/site-lisp/veritas.el
COPY --from=builder /src/veritas.elc /usr/share/emacs/site-lisp/veritas.elc

ENTRYPOINT ["emacs"]
CMD ["-nw"]
